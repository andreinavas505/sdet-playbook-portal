<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>90-Day Application Sprint Kanban Tracker | Global Tech Career</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg-dark: #030712;
      --card-dark: #090d16;
      --border-dark: #1e293b;
      --cyan-bright: #22d3ee;
      --emerald-bright: #34d399;
    }
    body {
      background-color: #030712;
      color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      box-sizing: border-box;
    }
    .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
    .custom-scroll::-webkit-scrollbar-track { background: #090d16; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
  </style>
</head>
<body class="antialiased">

  <div class="w-full max-w-3xl bg-[#090d16] border-2 border-cyan-500/70 rounded-2xl p-5 sm:p-7 shadow-2xl shadow-cyan-950/40 space-y-4">
    <div class="border-b border-slate-800 pb-4">
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cyan-950 border border-cyan-800 text-cyan-400">
          <i class="fa-solid fa-trello mr-1"></i> Interactive Lab 09
        </span>
        <span class="text-xs text-slate-400 font-semibold">Global Tech Career</span>
      </div>
      <h1 class="text-lg sm:text-xl font-bold text-white tracking-tight">90-Day Application Sprint Kanban Tracker</h1>
      <p class="text-xs text-slate-400">Track and manage your tier-1 candidate pipeline stages in real time.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-4 gap-2.5 text-xs">
      <div class="bg-[#030712] border border-slate-800 rounded-lg p-2.5 space-y-2">
        <div class="font-bold text-slate-300 uppercase text-[10px] flex justify-between">
          <span>1. Tailored Apps</span> <span class="text-cyan-400">3</span>
        </div>
        <div class="p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">Datadog (Staff SDET)</div>
        <div class="p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">Stripe (Quality Eng)</div>
      </div>
      <div class="bg-[#030712] border border-slate-800 rounded-lg p-2.5 space-y-2">
        <div class="font-bold text-amber-400 uppercase text-[10px] flex justify-between">
          <span>2. Recruiter Calls</span> <span class="text-amber-400">2</span>
        </div>
        <div class="p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">DoorDash (Screening)</div>
        <div class="p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">MongoDB (Intro)</div>
      </div>
      <div class="bg-[#030712] border border-slate-800 rounded-lg p-2.5 space-y-2">
        <div class="font-bold text-cyan-400 uppercase text-[10px] flex justify-between">
          <span>3. Tech Loops</span> <span class="text-cyan-400">1</span>
        </div>
        <div class="p-2 rounded bg-slate-900 border border-slate-800 text-slate-200">ClickUp (Architecture)</div>
      </div>
      <div class="bg-[#030712] border border-slate-800 rounded-lg p-2.5 space-y-2">
        <div class="font-bold text-emerald-400 uppercase text-[10px] flex justify-between">
          <span>4. Offer Stage</span> <span class="text-emerald-400">1</span>
        </div>
        <div class="p-2 rounded bg-emerald-950/40 border border-emerald-700/60 text-emerald-300 font-bold">HubSpot ($165k Base)</div>
      </div>
    </div>
  </div>

</body>
</html>
